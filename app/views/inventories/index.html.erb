<% content_for :title, "Inventories" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Inventories</h1>
    <%= link_to "New inventory", new_inventory_path, class: "btn btn-primary" %>
</div>

<h3>Latest Inventories</h3>
<table class="table table-striped">
  <thead>
    <tr>
      <th>Title</th>
      <th>Category</th>
      <th>Creator</th>
      <th>Items</th>
    </tr>
  </thead>
  <tbody>
    <% @latest_inventories.each do |inventory| %>
      <tr>
        <td><%= link_to inventory.title, inventory %></td>
        <td><%= inventory.category.name %></td>
        <td><%= inventory.creator.name %></td>
        <td><%= inventory.items_count %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<h3 class="mt-4">Top 5 Inventories</h3>
<table class="table table-striped">
  <thead>
    <tr>
      <th>Title</th>
      <th>Category</th>
      <th>Creator</th>
      <th>Items</th>
    </tr>
  </thead>
  <tbody>
    <% @top5_inventories.each do |inventory| %>
      <tr>
        <td><%= link_to inventory.title, inventory %></td>
        <td><%= inventory.category.name %></td>
        <td><%= inventory.creator.name %></td>
        <td><%= inventory.items_count %></td>
      </tr>
    <% end %>
  </tbody>
</table>