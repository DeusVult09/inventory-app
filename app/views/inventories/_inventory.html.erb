<% if inventory.errors.any? %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% inventory.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<%= form_with model: inventory do |form| %>
   <div class="mb-0">
     <%= form.label :title %>
     <%= form.text_field :title %>
  </div><br>

  <div>
     <%= form.label :description %>
     <%= form.text_field :description %><br>
  </div><br>

  <div>
     <%= form.label :category_id %>
     <%= form.text_field :category_id %><br>
  </div><br>

  <div >
    <%= form.check_box :is_public, class: "form-check-input" %>
    <%= form.label :is_public %>
  </div>

  <div>
     <%= form.submit "Create Inventory" %>
  </div><br>
<% end %>